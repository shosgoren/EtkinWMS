wms.etkinyazilim.com {
    encode zstd gzip
    # T-407 (inceleme m1): satış sitesi içerik ucu yalnız iç ağdan (marketing → web:3000); dışarıya kapalı.
    @sitecontent path /api/public/*
    respond @sitecontent 404
    reverse_proxy web:3000 {
        header_up Fly-Client-IP {http.request.remote.host}
    }
}

# ADR-027: Etkin Yönetim paneli. Aynı imajın panel kipindeki örneği; ayrı köken, ayrı oturum çerezi.
yonet.etkinyazilim.com {
    encode zstd gzip
    reverse_proxy panel:3000 {
        header_up Fly-Client-IP {http.request.remote.host}
    }
}

etkinyazilim.com {
    encode zstd gzip
    reverse_proxy marketing:3200
}

www.etkinyazilim.com, etkinyazilim.com.tr, www.etkinyazilim.com.tr {
    redir https://etkinyazilim.com{uri} permanent
}
